# ==========================================
# NUTRISNAP CONFIGURATION & SECRETS TEMPLATE (.env.example)
# ==========================================

# 1. AI Vision API Keys (Multi-Provider Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# 2. Database Connection String (SQL Server / PostgreSQL)
DATABASE_URL=Host=aws-0-ap-northeast-2.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres;Password=your_password;SSL Mode=Require;Trust Server Certificate=true;

# 3. Security & JWT Settings
JWT_SECRET=your_super_secret_jwt_key_here

# 4. Email / SMTP Configuration
BREVO_API_KEY=your_brevo_api_key_here
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
