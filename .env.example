# ==========================================
# NUTRISNAP CONFIGURATION & SECRETS (.env.example)
# Copy this file to .env and replace with your real keys
# ==========================================

# 1. AI Vision API Keys (Multi-Provider Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# 2. Database Connection String (Tự động hỗ trợ cả PostgreSQL & SQL Server)
# Khi Deploy lên Render / Supabase (Châu Á Singapore), dùng DATABASE_URL:
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Hoặc SQL Server (khi chạy cục bộ):
# ConnectionStrings__DefaultConnection=Server=.\\SQLEXPRESS;Database=NutriSnapDb;Trusted_Connection=True;TrustServerCertificate=True;

# 3. Security & JWT Settings
JWT_SECRET=your_super_secret_jwt_key_here

# 4. Email / SMTP Configuration
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
